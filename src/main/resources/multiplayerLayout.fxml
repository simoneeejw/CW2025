<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<BorderPane fx:controller="com.tetris.gui.MultiplayerGuiController" xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx">
    <stylesheets>
        <URL value="@styles.css" />
        <URL value="@window_style.css" />
    </stylesheets>
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <top>
        <VBox alignment="CENTER" BorderPane.alignment="CENTER" spacing="5">
            <Text text="TETRIS MULTIPLAYER" styleClass="title-text" />
            <Text text="N-BLOCK" styleClass="subtitle-text" />
        </VBox>
    </top>
    <center>
        <HBox spacing="10" BorderPane.alignment="CENTER">
            <!-- Player 1 -->
            <VBox spacing="10">
                <Label text="PLAYER 1" styleClass="player-label" />
                <HBox spacing="10">
                    <StackPane prefWidth="250" prefHeight="500" styleClass="game-board-container">
                        <GridPane fx:id="gamePanel1" hgap="1" vgap="1" />
                    </StackPane>
                    <VBox prefWidth="120" spacing="5" styleClass="sidebar-container">
                        <HBox alignment="CENTER_LEFT" spacing="5" styleClass="info-box">
                            <Label fx:id="scoreLabel1" text="Score: 0" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="5" styleClass="info-box">
                            <Label fx:id="linesLabel1" text="Lines: 0" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="5" styleClass="info-box">
                            <Label fx:id="levelLabel1" text="Level: 1" />
                            <Label fx:id="levelNameLabel1" text="Beginner" />
                        </HBox>
                        <VBox alignment="CENTER" spacing="3" styleClass="info-box">
                            <Label text="Held" styleClass="held-label" />
                            <GridPane fx:id="heldBlockPanel1" hgap="1" vgap="1" alignment="CENTER" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="3" styleClass="info-box">
                            <Label text="Next" styleClass="next-label" />
                            <GridPane fx:id="nextBlockPanel1" hgap="1" vgap="1" alignment="CENTER" />
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
            <!-- Player 2 -->
            <VBox spacing="10">
                <Label text="PLAYER 2" styleClass="player-label" />
                <HBox spacing="10">
                    <VBox prefWidth="120" spacing="5" styleClass="sidebar-container">
                        <HBox alignment="CENTER_LEFT" spacing="5" styleClass="info-box">
                            <Label fx:id="scoreLabel2" text="Score: 0" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="5" styleClass="info-box">
                            <Label fx:id="linesLabel2" text="Lines: 0" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="5" styleClass="info-box">
                            <Label fx:id="levelLabel2" text="Level: 1" />
                            <Label fx:id="levelNameLabel2" text="Beginner" />
                        </HBox>
                        <VBox alignment="CENTER" spacing="3" styleClass="info-box">
                            <Label text="Held" styleClass="held-label" />
                            <GridPane fx:id="heldBlockPanel2" hgap="1" vgap="1" alignment="CENTER" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="3" styleClass="info-box">
                            <Label text="Next" styleClass="next-label" />
                            <GridPane fx:id="nextBlockPanel2" hgap="1" vgap="1" alignment="CENTER" />
                        </VBox>
                    </VBox>
                    <StackPane prefWidth="250" prefHeight="500" styleClass="game-board-container">
                        <GridPane fx:id="gamePanel2" hgap="1" vgap="1" />
                    </StackPane>
                </HBox>
            </VBox>
        </HBox>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="10" BorderPane.alignment="CENTER" styleClass="bottom-bar">
            <Label fx:id="winnerLabel" text="" styleClass="winner-label" />
            <Button fx:id="pauseButton" text="PAUSE" styleClass="pause-button" />
            <Button fx:id="newGameButton" text="NEW GAME" styleClass="new-game-button" />
        </HBox>
    </bottom>
</BorderPane>
