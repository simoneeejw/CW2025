<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<BorderPane fx:controller="com.tetris.gui.GuiController" xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <top>
        <VBox alignment="CENTER" BorderPane.alignment="CENTER" spacing="5">
            <Text text="TETRIS" styleClass="title-text" />
            <Text text="N-BLOCK" styleClass="subtitle-text" />
        </VBox>
    </top>
    <center>
        <HBox spacing="20" BorderPane.alignment="CENTER">
            <StackPane prefWidth="300" prefHeight="600" styleClass="game-board-container">
                <GridPane fx:id="gamePanel" hgap="1" vgap="1" />
            </StackPane>
            <VBox prefWidth="150" spacing="10" styleClass="sidebar-container">
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="info-box">
                    <Label fx:id="scoreLabel" text="Score: 0" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="info-box">
                    <Label fx:id="linesLabel" text="Lines: 0" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="info-box">
                    <Label fx:id="levelLabel" text="Level: 1" />
                    <Label fx:id="levelNameLabel" text="Beginner" />
                </HBox>
            </VBox>
        </HBox>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="10" BorderPane.alignment="CENTER" styleClass="bottom-bar">
            <Text text="♫" styleClass="music-icon" />
            <Text text="-" styleClass="separator-text" />
            <Button fx:id="pauseButton" text="Pause" />
        </HBox>
    </bottom>
    <stylesheets>
        <URL value="@window_style.css"/>
        <URL value="@styles.css"/>
    </stylesheets>
</BorderPane>
